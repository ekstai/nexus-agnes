{
  "version": 8,
  "updatedAt": "2026-08-12",
  "plugins": [
    {
      "pluginKey": "browser-automation",
      "name": "内置浏览器",
      "description": "在应用内部打开 Chromium 内核浏览器（独立窗口，自带工具栏），支持网页自动化：打开网址、后退/前进/刷新、CSS 选择器点击、向输入框打字、执行 JS、页面截图、关闭。聊天中可指挥 AI 直接使用「browser」工具操作网页。",
      "category": "tool",
      "icon": "Monitor",
      "version": "1.0.0",
      "author": "Nexus Agnes",
      "builtin": true,
      "platforms": ["desktop"]
    },
    {
      "pluginKey": "theme-codex",
      "name": "Codex 深色",
      "description": "灵感来自 Codex：近黑背景、琥珀点缀、等宽字体、紧凑排版。不仅换色，还包含专属布局与交互：更窄的侧栏、更紧凑的顶部栏与消息流、输入区等宽字体，适合专注的终端式工作流。",
      "category": "theme",
      "icon": "Palette",
      "version": "1.0.0",
      "author": "Nexus Agnes",
      "platforms": ["desktop"],
      "theme": {
        "key": "theme-codex",
        "name": "Codex 深色",
        "description": "Codex 风格：深色 + 等宽字体 + 专属紧凑布局与交互",
        "layout": "codex",
        "variables": {
          "--background": "#0A0A0B",
          "--foreground": "#EDEDED",
          "--card": "#161618",
          "--card-foreground": "#EDEDED",
          "--popover": "#1C1C1F",
          "--popover-foreground": "#EDEDED",
          "--primary": "#F5980B",
          "--primary-foreground": "#0A0A0B",
          "--secondary": "#1E1E21",
          "--secondary-foreground": "#EDEDED",
          "--muted": "#232326",
          "--muted-foreground": "#9B9B9F",
          "--accent": "#F5980B26",
          "--accent-foreground": "#F5A623",
          "--destructive": "#EF4444",
          "--destructive-foreground": "#FFFFFF",
          "--success": "#3FB950",
          "--success-foreground": "#0A0A0B",
          "--warning": "#D29922",
          "--warning-foreground": "#0A0A0B",
          "--border": "#2A2A2E",
          "--input": "#333338",
          "--ring": "#F5980B",
          "--sidebar": "#0E0E10",
          "--sidebar-foreground": "#EDEDED",
          "--sidebar-primary": "#F5980B",
          "--sidebar-primary-foreground": "#0A0A0B",
          "--sidebar-accent": "#1C1C1F",
          "--sidebar-accent-foreground": "#F5A623",
          "--sidebar-border": "#232326",
          "--sidebar-ring": "#F5980B"
        },
        "css": "[data-theme=\"theme-codex\"]{--font-sans:'SF Mono',ui-monospace,'JetBrains Mono',Menlo,Consolas,'Courier New',monospace;--radius:6px}[data-theme=\"theme-codex\"] body,[data-theme=\"theme-codex\"] button,[data-theme=\"theme-codex\"] input,[data-theme=\"theme-codex\"] textarea{font-family:var(--font-sans)}[data-theme=\"theme-codex\"] textarea,[data-theme=\"theme-codex\"] input{caret-color:#F5980B}[data-theme=\"theme-codex\"] ::selection{background:rgba(245,152,11,0.3)}[data-theme=\"theme-codex\"] ::-webkit-scrollbar{width:8px;height:8px}[data-theme=\"theme-codex\"] ::-webkit-scrollbar-thumb{background:#2A2A2E;border-radius:4px}[data-theme=\"theme-codex\"] ::-webkit-scrollbar-thumb:hover{background:#3A3A40}[data-theme=\"theme-codex\"] .glass,[data-theme=\"theme-codex\"] .glass-strong,[data-theme=\"theme-codex\"] .backdrop-blur-xl,[data-theme=\"theme-codex\"] .backdrop-blur-lg,[data-theme=\"theme-codex\"] .backdrop-blur-md{backdrop-filter:none!important}",
        "preview": {
          "background": "#0A0A0B",
          "foreground": "#EDEDED",
          "primary": "#F5980B",
          "sidebar": "#0E0E10"
        }
      }
    },
